{{- $index := slice -}}
{{- range partial "posts.html" . -}}
  {{- $index = $index | append (dict "title" .Title "url" .RelPermalink "date" (.Date.Format "2006-01-02") "summary" (.Params.summary | default (.Summary | plainify)) "body" (partial "search-body.html" .) "tags" (.Params.tags | default slice) "series" (.Params.series | default slice)) -}}
{{- end -}}
{{- $index | jsonify | safeJS -}}
